APP_NAME=MIRA Medical Document Assistant
APP_VERSION=0.3.0
ENVIRONMENT=development

DATABASE_URL=
SQL_ECHO=false

POSTGRES_USER=
POSTGRES_PASSWORD=

# Generate a real value for local .env:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

REFRESH_TOKEN_EXPIRE_DAYS=7

JWT_ISSUER=mira-api
JWT_AUDIENCE=mira-web

ACCESS_COOKIE_NAME=mira_access
REFRESH_COOKIE_NAME=mira_refresh
CSRF_COOKIE_NAME=mira_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# false for local HTTP development.
# Must be true in production HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

CSRF_ENABLED=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_REQUESTS=240
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_REQUESTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_REFRESH_REQUESTS=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=900

EXPOSE_API_DOCS=true
HSTS_ENABLED=false

TRUSTED_HOSTS=localhost,127.0.0.1,testserver

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

CHUNK_SIZE=500
CHUNK_OVERLAP=100
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

RETRIEVAL_TOP_K=3
RETRIEVAL_CANDIDATE_K=10
RETRIEVAL_RRF_K=60
RETRIEVAL_SEMANTIC_WEIGHT=1.0
RETRIEVAL_LEXICAL_WEIGHT=1.0
RETRIEVAL_BM25_K1=1.5
RETRIEVAL_BM25_B=0.75

RETRIEVAL_RERANKER_ENABLED=true
RETRIEVAL_RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2
RETRIEVAL_RERANKER_BATCH_SIZE=16
RETRIEVAL_RERANKER_DEVICE=
RETRIEVAL_RERANKER_FAIL_OPEN=true
RETRIEVAL_LEXICAL_MAX_CHUNKS=2000

RETRIEVAL_ADAPTIVE_TOP_K_ENABLED=true
RETRIEVAL_ADAPTIVE_TOP_K_MAX=5

RAG_QA_CONTEXT_MAX_ESTIMATED_TOKENS=2200
RAG_SUMMARY_CONTEXT_MAX_ESTIMATED_TOKENS=12000
RAG_MULTI_DOCUMENT_CONTEXT_MAX_ESTIMATED_TOKENS=20000

LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=
LLM_MODEL_NAME=llama3.2

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL_NAME=llama3.2:latest

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_NAME=openai/gpt-oss-20b

TAVILY_API_KEY=

EXTRACTION_MAX_CONTEXT_CHARACTERS=16000
EXTRACTION_LLM_TIMEOUT_SECONDS=180
EXTRACTION_LLM_MAX_OUTPUT_TOKENS=1600
EXTRACTION_LLM_CONTEXT_WINDOW=8192
EXTRACTION_LLM_KEEP_ALIVE=10m
EXTRACTION_ENABLE_REPAIR=true
EXTRACTION_MAX_REPAIR_PROMPT_CHARACTERS=12000
EXTRACTION_ALLOW_DETERMINISTIC_FALLBACK=true
EXTRACTION_LOG_TIMINGS=true